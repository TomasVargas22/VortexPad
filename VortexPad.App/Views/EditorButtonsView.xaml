<UserControl x:Class="VortexPad.App.Views.EditorButtonsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Sección «Botones y capas»: lista de capas + detalle. DataContext = ProfileEditorViewModel. -->
    <UserControl.Resources>
        <ResourceDictionary Source="EditorTemplates.xaml"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Capas del perfil" Style="{StaticResource CardTitle}"/>
                <ListBox ItemsSource="{Binding AllLayers}" SelectedItem="{Binding SelectedLayer}" MaxHeight="420"
                         AutomationProperties.Name="Capas del perfil">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Base}"/>
                                <TextBlock Style="{StaticResource Text.Caption}">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} reasignaciones · {1} teclas">
                                            <Binding Path="Remaps.Count"/>
                                            <Binding Path="KeyBindings.Count"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <WrapPanel Margin="0,12,0,0">
                    <Button x:Name="BtnAddLayer" Style="{StaticResource Button.Small}" Command="{Binding AddShiftLayerCommand}" Margin="0,0,8,8"
                            ToolTip="Una capa Shift cambia los botones mientras mantienes otro botón">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Text.IconInline}" Text="&#xE710;"/><TextBlock Text="Agregar capa"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.GhostSmall}" Command="{Binding RemoveShiftLayerCommand}" CommandParameter="{Binding SelectedLayer}"
                            Margin="0,0,0,8" ToolTip="La capa base no se puede quitar">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Text.IconInline}" Text="&#xE74D;"/><TextBlock Text="Quitar capa"/></StackPanel>
                    </Button>
                </WrapPanel>
                <TextBlock Style="{StaticResource Text.SecondaryWrap}"
                           Text="Mute y los botones Fn del DualSense Edge también se pueden reasignar aquí."/>
            </StackPanel>
        </Border>

        <ContentControl Grid.Column="2" Content="{Binding SelectedLayer}" Focusable="False" VerticalAlignment="Top"/>
    </Grid>
</UserControl>
