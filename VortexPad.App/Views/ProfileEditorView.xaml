<UserControl x:Class="VortexPad.App.Views.ProfileEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VortexPad.ViewModels;assembly=VortexPad.ViewModels"
             xmlns:views="clr-namespace:VortexPad.App.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#00E5FF"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Margin" Value="0,2,0,3"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Margin" Value="0,2,0,6"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0F141E"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#263044"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource FluentButton}">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#0F141E"/>
            <Setter Property="BorderBrush" Value="#263044"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Dark tabs -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Background="#131822" BorderBrush="#263044" BorderThickness="1,1,1,0"
                                CornerRadius="6,6,0,0" Padding="7,4" Margin="0,0,2,0">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1B2230"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#00E5FF"/>
                                <Setter Property="Foreground" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Stick ===== -->
        <DataTemplate DataType="{x:Type vm:StickViewModel}">
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                    <TextBlock Text="Tipo de deadzone:" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{x:Static vm:EditorOptions.DeadzoneModes}" SelectedValuePath="Value"
                              SelectedValue="{Binding DeadzoneMode}"/>
                    <views:LabeledSlider Label="Deadzone interna" Format="percent" Minimum="0" Maximum="0.5" Step="0.005"
                                         Value="{Binding InnerDeadzone}"/>
                    <views:LabeledSlider Label="Deadzone axial" Format="percent" Minimum="0" Maximum="0.3" Step="0.005"
                                         Value="{Binding AxialDeadzone}"
                                         Visibility="{Binding UsesAxialDeadzone, Converter={StaticResource BoolToVis}}"/>
                    <views:LabeledSlider Label="Saturación externa" Format="percent" Minimum="0.5" Maximum="1" Step="0.005"
                                         Value="{Binding OuterDeadzone}"/>
                    <views:LabeledSlider Label="Anti-deadzone" Format="percent" Minimum="0" Maximum="0.5" Step="0.005"
                                         Value="{Binding AntiDeadzone}"/>
                    <TextBlock Text="Curva de respuesta:" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{x:Static vm:EditorOptions.CurveTypes}" SelectedValuePath="Value"
                              SelectedValue="{Binding CurveType}"/>
                    <views:LabeledSlider Label="Exponente (γ)" Minimum="0.2" Maximum="5" Step="0.05"
                                         Value="{Binding CurveExponent}"
                                         Visibility="{Binding UsesExponent, Converter={StaticResource BoolToVis}}"/>
                    <StackPanel Visibility="{Binding IsBezier, Converter={StaticResource BoolToVis}}">
                        <views:LabeledSlider Label="Bézier punto 1" Minimum="0" Maximum="1" Value="{Binding BezierP1}"/>
                        <views:LabeledSlider Label="Bézier punto 2" Minimum="0" Maximum="1" Value="{Binding BezierP2}"/>
                    </StackPanel>
                    <views:LabeledSlider Label="Sensibilidad" Format="{}{0:F2}x" Minimum="0.1" Maximum="3" Step="0.05"
                                         Value="{Binding Sensitivity}"/>
                    <UniformGrid Columns="2">
                        <CheckBox Content="Invertir X" IsChecked="{Binding InvertX}"/>
                        <CheckBox Content="Invertir Y" IsChecked="{Binding InvertY}"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ===== Trigger ===== -->
        <DataTemplate DataType="{x:Type vm:TriggerViewModel}">
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                    <views:LabeledSlider Label="Deadzone interna" Format="percent" Minimum="0" Maximum="0.5" Step="0.005"
                                         Value="{Binding InnerDeadzone}"/>
                    <views:LabeledSlider Label="Saturación externa" Format="percent" Minimum="0.5" Maximum="1" Step="0.005"
                                         Value="{Binding OuterDeadzone}"/>
                    <TextBlock Text="Curva:" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{x:Static vm:EditorOptions.CurveTypes}" SelectedValuePath="Value"
                              SelectedValue="{Binding CurveType}"/>
                    <views:LabeledSlider Label="Exponente (γ)" Minimum="0.2" Maximum="5" Step="0.05"
                                         Value="{Binding CurveExponent}"
                                         Visibility="{Binding UsesExponent, Converter={StaticResource BoolToVis}}"/>
                    <views:LabeledSlider Label="Sensibilidad" Format="{}{0:F2}x" Minimum="0.1" Maximum="3" Step="0.05"
                                         Value="{Binding Sensitivity}"/>
                    <CheckBox Content="Hair-trigger (disparo instantáneo)" IsChecked="{Binding HairTriggerMode}"/>
                    <views:LabeledSlider Label="Umbral del hair-trigger" Format="percent" Minimum="0.01" Maximum="0.9" Step="0.01"
                                         Value="{Binding HairTriggerThreshold}"
                                         Visibility="{Binding HairTriggerMode, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ===== Mapping layer ===== -->
        <DataTemplate DataType="{x:Type vm:MappingLayerViewModel}">
            <StackPanel>
                <TextBlock Text="Nombre de la capa:" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}"/>
                <StackPanel Visibility="{Binding IsShiftLayer, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Botón que activa la capa (mantener):" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{x:Static vm:EditorOptions.RealButtons}" SelectedValuePath="Value"
                              SelectedValue="{Binding ShiftModifierButton}"/>
                </StackPanel>
                <CheckBox Content="Stick izquierdo → WASD" IsChecked="{Binding LeftStickToWasd}"/>
                <CheckBox Content="Stick derecho → ratón" IsChecked="{Binding RightStickToMouse}"/>
                <views:LabeledSlider Label="Sensibilidad del ratón (stick)" Format="{}{0:F1}" Minimum="1" Maximum="50" Step="0.5"
                                     Value="{Binding StickMouseSensitivity}"
                                     Visibility="{Binding RightStickToMouse, Converter={StaticResource BoolToVis}}"/>

                <TextBlock Text="Remapeo de botones" Style="{StaticResource SectionTitle}"/>
                <ItemsControl ItemsSource="{Binding Remaps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" ItemsSource="{x:Static vm:EditorOptions.RealButtons}"
                                          SelectedValuePath="Value" SelectedValue="{Binding Source}"/>
                                <TextBlock Grid.Column="1" Text=" → " Foreground="#94A3B8" VerticalAlignment="Center" Margin="2,0,2,6"/>
                                <ComboBox Grid.Column="2" ItemsSource="{x:Static vm:EditorOptions.Buttons}"
                                          SelectedValuePath="Value" SelectedValue="{Binding Target}"/>
                                <Button Grid.Column="3" Style="{StaticResource SmallButton}" Content="✕" Margin="4,0,0,6"
                                        ToolTip="Quitar"
                                        Command="{Binding DataContext.RemoveRemapCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource SmallButton}" Content="+ Remapeo" HorizontalAlignment="Left"
                        Command="{Binding AddRemapCommand}" Margin="0,0,0,6"/>

                <TextBlock Text="Botón → tecla" Style="{StaticResource SectionTitle}"/>
                <ItemsControl ItemsSource="{Binding KeyBindings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" ItemsSource="{x:Static vm:EditorOptions.RealButtons}"
                                          SelectedValuePath="Value" SelectedValue="{Binding Source}"/>
                                <TextBlock Grid.Column="1" Text=" → " Foreground="#94A3B8" VerticalAlignment="Center" Margin="2,0,2,6"/>
                                <ComboBox Grid.Column="2" ItemsSource="{x:Static vm:VirtualKeyCatalog.Keys}"
                                          SelectedValuePath="Value" SelectedValue="{Binding VirtualKey}"/>
                                <Button Grid.Column="3" Style="{StaticResource SmallButton}" Content="✕" Margin="4,0,0,6"
                                        ToolTip="Quitar"
                                        Command="{Binding DataContext.RemoveKeyBindingCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource SmallButton}" Content="+ Tecla" HorizontalAlignment="Left"
                        Command="{Binding AddKeyBindingCommand}" Margin="0,0,0,6"/>

                <TextBlock Text="⚠ Hay botones físicos repetidos: se usa la última fila." Foreground="#F59E0B" FontSize="11"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasDuplicateSources, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- ===== Response curve (Bézier with draggable points) ===== -->
        <StackPanel DockPanel.Dock="Top">
            <DockPanel Margin="0,0,0,6">
                <ComboBox DockPanel.Dock="Right" Width="140" Margin="0" SelectedIndex="{Binding CurveStickIndex}">
                    <ComboBoxItem Content="Stick izquierdo"/>
                    <ComboBoxItem Content="Stick derecho"/>
                </ComboBox>
                <TextBlock Text="CURVA DE RESPUESTA" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
            </DockPanel>
            <Border Background="#0B0F17" BorderBrush="#263044" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,8">
                <StackPanel HorizontalAlignment="Center">
                    <Canvas x:Name="CanvasCurve" Width="300" Height="150" Background="#0F172A" ClipToBounds="True">
                        <Line X1="0" Y1="150" X2="300" Y2="0" Stroke="#334155" StrokeThickness="1" StrokeDashArray="4,4"/>
                        <Line x:Name="LineHandle1" Stroke="#475569" StrokeThickness="1" StrokeDashArray="2,2"/>
                        <Line x:Name="LineHandle2" Stroke="#475569" StrokeThickness="1" StrokeDashArray="2,2"/>
                        <Polyline x:Name="PolyCurve" Stroke="#00E5FF" StrokeThickness="2.5"/>
                        <Ellipse x:Name="DotLive" Width="10" Height="10" Fill="#F43F5E" Stroke="#FFFFFF" StrokeThickness="1.5"/>
                        <Ellipse x:Name="HandleP1" Width="14" Height="14" Fill="#9D4EDD" Stroke="#FFFFFF" StrokeThickness="1.5"
                                 Cursor="SizeNS" ToolTip="Arrastra para ajustar el punto 1 de la Bézier"
                                 MouseLeftButtonDown="Handle_MouseDown" MouseMove="Handle_MouseMove" MouseLeftButtonUp="Handle_MouseUp"/>
                        <Ellipse x:Name="HandleP2" Width="14" Height="14" Fill="#9D4EDD" Stroke="#FFFFFF" StrokeThickness="1.5"
                                 Cursor="SizeNS" ToolTip="Arrastra para ajustar el punto 2 de la Bézier"
                                 MouseLeftButtonDown="Handle_MouseDown" MouseMove="Handle_MouseMove" MouseLeftButtonUp="Handle_MouseUp"/>
                    </Canvas>
                    <TextBlock x:Name="TxtCurveSummary" FontSize="10.5" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <TabControl Background="#131822" BorderBrush="#263044" Padding="8">
            <!-- ===== Sticks ===== -->
            <TabItem Header="Sticks">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ContentControl Content="{Binding LeftStick}"/>
                        <ContentControl Content="{Binding RightStick}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Triggers ===== -->
            <TabItem Header="Gatillos">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ContentControl Content="{Binding LeftTrigger}"/>
                        <ContentControl Content="{Binding RightTrigger}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Gyro ===== -->
            <TabItem Header="Giro">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding Gyro}">
                        <TextBlock Text="Salida del giroscopio:" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{x:Static vm:EditorOptions.GyroOutputModes}" SelectedValuePath="Value"
                                  SelectedValue="{Binding OutputMode}"/>
                        <StackPanel Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Activación:" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{x:Static vm:EditorOptions.GyroActivationModes}" SelectedValuePath="Value"
                                      SelectedValue="{Binding ActivationMode}"/>
                            <StackPanel Visibility="{Binding NeedsActivationButton, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Botón de activación:" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{x:Static vm:EditorOptions.RealButtons}" SelectedValuePath="Value"
                                          SelectedValue="{Binding ActivationButton}"/>
                            </StackPanel>
                            <views:LabeledSlider Label="Sensibilidad horizontal" Format="{}{0:F1}x" Minimum="0.1" Maximum="10" Step="0.1"
                                                 Value="{Binding SensitivityX}"/>
                            <views:LabeledSlider Label="Sensibilidad vertical" Format="{}{0:F1}x" Minimum="0.1" Maximum="10" Step="0.1"
                                                 Value="{Binding SensitivityY}"/>
                            <views:LabeledSlider Label="Umbral de ruido" Format="{}{0:F2} °/s" Minimum="0" Maximum="5" Step="0.05"
                                                 Value="{Binding NoiseThresholdDegPerSec}"/>
                            <views:LabeledSlider Label="Suavizado" Format="percent" Minimum="0" Maximum="0.95" Step="0.01"
                                                 Value="{Binding SmoothingFactor}"/>
                            <UniformGrid Columns="2">
                                <CheckBox Content="Invertir horizontal" IsChecked="{Binding InvertYaw}"/>
                                <CheckBox Content="Invertir vertical" IsChecked="{Binding InvertPitch}"/>
                            </UniformGrid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Layers ===== -->
            <TabItem Header="Capas">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="− Quitar" Margin="4,0,0,0"
                                    ToolTip="Quitar la capa Shift seleccionada"
                                    Command="{Binding RemoveShiftLayerCommand}" CommandParameter="{Binding SelectedLayer}"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="+ Capa Shift" Margin="4,0,0,0"
                                    Command="{Binding AddShiftLayerCommand}"/>
                            <ComboBox ItemsSource="{Binding AllLayers}" DisplayMemberPath="Name" Margin="0"
                                      SelectedItem="{Binding SelectedLayer}"/>
                        </DockPanel>
                        <Border Style="{StaticResource CardBorder}">
                            <ContentControl Content="{Binding SelectedLayer}"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Turbo ===== -->
            <TabItem Header="Turbo">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Turbos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardBorder}">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="✕" Margin="4,0,0,6"
                                                        ToolTip="Quitar turbo"
                                                        Command="{Binding DataContext.RemoveTurboCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <CheckBox DockPanel.Dock="Right" Content="Activo" IsChecked="{Binding Enabled}"
                                                          VerticalAlignment="Center" Margin="6,0,0,6"/>
                                                <ComboBox ItemsSource="{x:Static vm:EditorOptions.RealButtons}" SelectedValuePath="Value"
                                                          SelectedValue="{Binding Button}"/>
                                            </DockPanel>
                                            <views:LabeledSlider Label="Frecuencia" Format="{}{0:F0} Hz" Minimum="0.5" Maximum="40" Step="0.5"
                                                                 Value="{Binding FrequencyHz}"/>
                                            <views:LabeledSlider Label="Ciclo de trabajo (tiempo pulsado)" Format="percent" Minimum="0.1" Maximum="0.9" Step="0.05"
                                                                 Value="{Binding DutyCycle}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource SmallButton}" Content="+ Turbo en un botón" HorizontalAlignment="Left"
                                Command="{Binding AddTurboCommand}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Macros ===== -->
            <TabItem Header="Macros">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="− Quitar" Margin="4,0,0,0"
                                    Command="{Binding RemoveMacroCommand}" CommandParameter="{Binding SelectedMacro}"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="+ Macro" Margin="4,0,0,0"
                                    Command="{Binding AddMacroCommand}"/>
                            <ComboBox ItemsSource="{Binding Macros}" DisplayMemberPath="Name" Margin="0"
                                      SelectedItem="{Binding SelectedMacro}"/>
                        </DockPanel>

                        <Border DataContext="{Binding SelectedMacro}">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource CardBorder}">
                                    <Style.Triggers>
                                        <Trigger Property="DataContext" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="Nombre:" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Text="Botón que la dispara:" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{x:Static vm:EditorOptions.Buttons}" SelectedValuePath="Value"
                                          SelectedValue="{Binding TriggerButton}"/>
                                <CheckBox Content="Repetir mientras se mantiene" IsChecked="{Binding RepeatWhileHeld}"/>
                                <TextBlock Foreground="#94A3B8" FontSize="11" Margin="0,0,0,6"
                                           Text="{Binding TotalDurationMs, StringFormat=Duración total: {0} ms}"/>

                                <TextBlock Text="Pasos" Style="{StaticResource SectionTitle}"/>
                                <ItemsControl ItemsSource="{Binding Steps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#263044" BorderThickness="0,0,0,1" Padding="0,0,0,4" Margin="0,0,0,4">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="✕" Margin="2,0,0,6"
                                                                Command="{Binding DataContext.RemoveStepCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="↓" Margin="2,0,0,6"
                                                                Command="{Binding DataContext.MoveStepDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="↑" Margin="2,0,0,6"
                                                                Command="{Binding DataContext.MoveStepUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"/>
                                                        <ComboBox ItemsSource="{x:Static vm:EditorOptions.MacroStepTypes}" SelectedValuePath="Value"
                                                                  SelectedValue="{Binding StepType}"/>
                                                    </DockPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="70"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ComboBox Grid.Column="0" ItemsSource="{x:Static vm:EditorOptions.RealButtons}" SelectedValuePath="Value"
                                                                  SelectedValue="{Binding Button}"
                                                                  Visibility="{Binding UsesButton, Converter={StaticResource BoolToVis}}"/>
                                                        <ComboBox Grid.Column="0" ItemsSource="{x:Static vm:VirtualKeyCatalog.Keys}" SelectedValuePath="Value"
                                                                  SelectedValue="{Binding VirtualKeyCode}"
                                                                  Visibility="{Binding UsesKey, Converter={StaticResource BoolToVis}}"/>
                                                        <TextBox Grid.Column="1" Margin="4,0,0,6" Text="{Binding DurationMs, UpdateSourceTrigger=LostFocus}"
                                                                 ToolTip="Duración del paso en milisegundos"/>
                                                        <TextBlock Grid.Column="2" Text="ms" Foreground="#94A3B8" VerticalAlignment="Center" Margin="4,0,0,6"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Style="{StaticResource SmallButton}" Content="+ Paso" HorizontalAlignment="Left"
                                        Command="{Binding AddStepCommand}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== General + vibration ===== -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Nombre del perfil:" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="Descripción:" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=LostFocus}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="44"/>

                        <TextBlock Text="Mando virtual emulado:" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{x:Static vm:EditorOptions.TargetControllers}" SelectedValuePath="Value"
                                  SelectedValue="{Binding TargetControllerType}"/>

                        <TextBlock Text="Frecuencia de polling:" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{x:Static vm:EditorOptions.PollingRates}" SelectedValuePath="Value"
                                  SelectedValue="{Binding PollingRateHz}"/>

                        <TextBlock Text="Color de la barra de luz (#RRGGBB):" Style="{StaticResource FieldLabel}"/>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Width="40" Height="24" CornerRadius="5" Margin="6,0,0,6"
                                    BorderBrush="#FFFFFF" BorderThickness="1" Background="{Binding LightbarHex}"/>
                            <TextBox Text="{Binding LightbarHex, UpdateSourceTrigger=LostFocus}"/>
                        </DockPanel>
                        <TextBlock Text="{Binding LightbarError}" Foreground="#F59E0B" FontSize="11" TextWrapping="Wrap"/>

                        <CheckBox Content="Ocultar mando físico con HidHide" IsChecked="{Binding HidePhysicalControllerWithHidHide}"/>

                        <TextBlock Text="Auto-switch por juego (.exe separados por coma):" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding LinkedProcessesText, UpdateSourceTrigger=LostFocus}" ToolTip="Ej: eldenring, cod, forza_horizon5"/>

                        <TextBlock Text="VIBRACIÓN" Style="{StaticResource SectionTitle}"/>
                        <StackPanel DataContext="{Binding ForceFeedback}">
                            <CheckBox Content="Enviar vibración al mando físico" IsChecked="{Binding Enabled}"/>
                            <views:LabeledSlider Label="Intensidad general" Format="percent" Minimum="0" Maximum="2" Step="0.05"
                                                 Value="{Binding OverallStrength}"/>
                            <views:LabeledSlider Label="Motor grande (graves)" Format="percent" Minimum="0" Maximum="2" Step="0.05"
                                                 Value="{Binding LargeMotorGain}"/>
                            <views:LabeledSlider Label="Motor pequeño (agudos)" Format="percent" Minimum="0" Maximum="2" Step="0.05"
                                                 Value="{Binding SmallMotorGain}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
