<UserControl x:Class="VortexPad.App.Views.LabeledSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <StackPanel Margin="0,0,0,12">
        <DockPanel>
            <TextBlock Text="{Binding ElementName=Root, Path=DisplayText}" DockPanel.Dock="Right"
                       Style="{StaticResource Text.Data}" Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ElementName=Root, Path=Label}" Style="{StaticResource Text.Secondary}"
                       Foreground="{StaticResource Brush.Text}" Margin="0,0,12,0"/>
        </DockPanel>
        <Slider x:Name="Part"
                Minimum="{Binding ElementName=Root, Path=Minimum}"
                Maximum="{Binding ElementName=Root, Path=Maximum}"
                Value="{Binding ElementName=Root, Path=Value, Mode=TwoWay}"
                SmallChange="{Binding ElementName=Root, Path=Step}"
                AutomationProperties.Name="{Binding ElementName=Root, Path=Label}"
                AutomationProperties.HelpText="{Binding ElementName=Root, Path=DisplayText}"
                Margin="0,4,0,0"/>
    </StackPanel>
</UserControl>
