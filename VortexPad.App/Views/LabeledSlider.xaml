<UserControl x:Class="VortexPad.App.Views.LabeledSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <StackPanel Margin="0,0,0,6">
        <DockPanel>
            <TextBlock Text="{Binding ElementName=Root, Path=DisplayText}" DockPanel.Dock="Right"
                       FontSize="11.5" Foreground="#00E5FF"/>
            <TextBlock Text="{Binding ElementName=Root, Path=Label}" FontSize="11.5" Foreground="#E2E8F0"
                       TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <Slider Minimum="{Binding ElementName=Root, Path=Minimum}"
                Maximum="{Binding ElementName=Root, Path=Maximum}"
                Value="{Binding ElementName=Root, Path=Value, Mode=TwoWay}"
                SmallChange="{Binding ElementName=Root, Path=Step}"
                LargeChange="{Binding ElementName=Root, Path=Step}"
                Margin="0,2,0,0"/>
    </StackPanel>
</UserControl>
