<UserControl x:Class="VortexPad.App.Views.DualSenseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VortexPad.ViewModels;assembly=VortexPad.ViewModels"
             xmlns:views="clr-namespace:VortexPad.App.Views">
    <!-- Sección «DualSense»: touchpad y gatillos adaptativos. DataContext = ProfileEditorViewModel. -->
    <UserControl.Resources>
        <ResourceDictionary Source="EditorTemplates.xaml"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" VerticalAlignment="Top" DataContext="{Binding Touchpad}">
            <StackPanel>
                <TextBlock Text="Touchpad" Style="{StaticResource CardTitle}"/>
                <StackPanel Style="{StaticResource FieldBlock}">
                    <TextBlock Text="Uso del touchpad" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{x:Static vm:EditorOptions.TouchpadModes}" SelectedValuePath="Value"
                              SelectedValue="{Binding Mode}" AutomationProperties.Name="Uso del touchpad"/>
                </StackPanel>
                <StackPanel Visibility="{Binding IsMouseMode, Converter={StaticResource BoolToVis}}">
                    <views:LabeledSlider Label="Sensibilidad del ratón" Format="{}{0:F1}×" Minimum="0.1" Maximum="5" Step="0.1"
                                         Value="{Binding MouseSensitivity}"/>
                    <CheckBox Content="Desplazar con dos dedos" IsChecked="{Binding TwoFingerScroll}"/>
                    <StackPanel Visibility="{Binding TwoFingerScroll, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                        <views:LabeledSlider Label="Velocidad del desplazamiento" Format="{}{0:F1}×" Minimum="0.1" Maximum="5" Step="0.1"
                                             Value="{Binding ScrollSensitivity}"/>
                        <CheckBox Content="Invertir el desplazamiento" IsChecked="{Binding InvertScroll}"/>
                    </StackPanel>
                    <CheckBox Content="Clic: mitad izquierda = clic izquierdo, mitad derecha = clic derecho" IsChecked="{Binding ClickAsMouseButtons}"/>
                </StackPanel>
                <CheckBox Content="Dividir el clic del touchpad en dos zonas" IsChecked="{Binding SplitClickZones}"/>
                <Grid Visibility="{Binding UsesZones, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Zona izquierda pulsa" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{x:Static vm:EditorOptions.Buttons}" SelectedValuePath="Value"
                                  SelectedValue="{Binding LeftZoneButton}" AutomationProperties.Name="Botón de la zona izquierda"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Zona derecha pulsa" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{x:Static vm:EditorOptions.Buttons}" SelectedValuePath="Value"
                                  SelectedValue="{Binding RightZoneButton}" AutomationProperties.Name="Botón de la zona derecha"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel Grid.Column="2">
            <ContentControl Content="{Binding LeftAdaptiveTrigger}" Focusable="False" Margin="{StaticResource Gap.Bottom4}"/>
            <ContentControl Content="{Binding RightAdaptiveTrigger}" Focusable="False"/>
        </StackPanel>
    </Grid>
</UserControl>
