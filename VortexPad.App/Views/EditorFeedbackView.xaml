<UserControl x:Class="VortexPad.App.Views.EditorFeedbackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:VortexPad.App.Views">
    <!-- Sección «Vibración y luz». DataContext = ProfileEditorViewModel. -->
    <UserControl.Resources>
        <ResourceDictionary Source="EditorTemplates.xaml"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" VerticalAlignment="Top" DataContext="{Binding ForceFeedback}">
            <StackPanel>
                <TextBlock Text="Vibración" Style="{StaticResource CardTitle}"/>
                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Base}" Text="Enviar la vibración del juego al mando físico"/>
                        <TextBlock Style="{StaticResource Text.Secondary}" Text="Solo DualSense y DualShock 4 por HID nativo."/>
                    </StackPanel>
                </CheckBox>
                <StackPanel IsEnabled="{Binding Enabled}">
                    <views:LabeledSlider Label="Intensidad general" Format="percent" Minimum="0" Maximum="2" Step="0.05"
                                         Value="{Binding OverallStrength}"/>
                    <views:LabeledSlider Label="Motor grande (graves)" Format="percent" Minimum="0" Maximum="2" Step="0.05"
                                         Value="{Binding LargeMotorGain}"/>
                    <views:LabeledSlider Label="Motor pequeño (agudos)" Format="percent" Minimum="0" Maximum="2" Step="0.05"
                                         Value="{Binding SmallMotorGain}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Barra de luz" Style="{StaticResource CardTitle}"/>
                <TextBlock Text="Color" Style="{StaticResource FieldLabel}"/>
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="{StaticResource Radius.Sm}" Margin="0,0,8,0"
                            BorderBrush="{StaticResource Brush.LineControl}" BorderThickness="1" Background="{Binding LightbarHex}"/>
                    <TextBox Text="{Binding LightbarHex, UpdateSourceTrigger=LostFocus}" Width="140" HorizontalAlignment="Left"
                             AutomationProperties.Name="Color de la barra de luz en hexadecimal"/>
                </DockPanel>
                <TextBlock Text="{Binding LightbarError}" Foreground="{StaticResource Brush.Danger}" Style="{StaticResource Text.SecondaryWrap}" Margin="0,6,0,0"/>
                <TextBlock Style="{StaticResource Text.SecondaryWrap}" Margin="0,6,0,0"
                           Text="Formato #RRGGBB. Se aplica al DualSense y al DualShock 4 conectados por HID nativo."/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
