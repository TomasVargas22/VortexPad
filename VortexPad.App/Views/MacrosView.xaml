<UserControl x:Class="VortexPad.App.Views.MacrosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VortexPad.ViewModels;assembly=VortexPad.ViewModels"
             xmlns:views="clr-namespace:VortexPad.App.Views">
    <!-- Sección «Macros y turbo»: lista + detalle. DataContext = ProfileEditorViewModel. -->
    <UserControl.Resources>
        <ResourceDictionary Source="EditorTemplates.xaml"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Lista de macros + turbo ===== -->
        <StackPanel Grid.Column="0">
            <Border Style="{StaticResource Card}" Margin="{StaticResource Gap.Bottom4}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Secondary}" Text="{Binding Macros.Count}" VerticalAlignment="Center"/>
                        <TextBlock Text="Macros del perfil" Style="{StaticResource Text.Heading}"/>
                    </DockPanel>
                    <ListBox ItemsSource="{Binding Macros}" SelectedItem="{Binding SelectedMacro}" MaxHeight="300"
                             VirtualizingPanel.IsVirtualizing="True" AutomationProperties.Name="Macros del perfil">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Base}"/>
                                    <TextBlock Style="{StaticResource Text.Caption}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} pasos · {1} ms">
                                                <Binding Path="Steps.Count"/>
                                                <Binding Path="TotalDurationMs"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- Vacío -->
                    <StackPanel x:Name="MacrosEmpty" Margin="0,4,0,8">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Macros.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Style="{StaticResource Text.Base}" FontWeight="SemiBold" Text="Este perfil no tiene macros"/>
                        <TextBlock Style="{StaticResource Text.SecondaryWrap}" Margin="0,4,0,0"
                                   Text="Una macro repite una secuencia de botones con un solo botón del mando."/>
                    </StackPanel>
                    <Button Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Command="{Binding AddMacroCommand}" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Text.IconInline}" Text="&#xE710;"/><TextBlock Text="Nueva macro"/></StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Turbo" Style="{StaticResource CardTitle}"/>
                    <ItemsControl ItemsSource="{Binding Turbos}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card.Inset}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.IconSmall}" Content="&#xE711;" Margin="8,0,0,0"
                                                    ToolTip="Quitar turbo" AutomationProperties.Name="Quitar turbo"
                                                    Command="{Binding DataContext.RemoveTurboCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <CheckBox DockPanel.Dock="Right" Content="Activo" IsChecked="{Binding Enabled}" Margin="8,0,0,0"/>
                                            <ComboBox ItemsSource="{x:Static vm:EditorOptions.RealButtons}" SelectedValuePath="Value"
                                                      SelectedValue="{Binding Button}" AutomationProperties.Name="Botón con turbo"/>
                                        </DockPanel>
                                        <views:LabeledSlider Label="Pulsaciones por segundo" Format="{}{0:F1}" Minimum="0.5" Maximum="40" Step="0.5"
                                                             Value="{Binding FrequencyHz}"/>
                                        <views:LabeledSlider Label="Tiempo pulsado" Format="percent" Minimum="0.1" Maximum="0.9" Step="0.05"
                                                             Value="{Binding DutyCycle}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource Button.GhostSmall}" HorizontalAlignment="Left" Command="{Binding AddTurboCommand}">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Text.IconInline}" Text="&#xE710;"/><TextBlock Text="Agregar turbo"/></StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ===== Detalle de la macro ===== -->
        <Border Grid.Column="2" VerticalAlignment="Top" DataContext="{Binding SelectedMacro}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                    <Style.Triggers>
                        <Trigger Property="DataContext" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <DockPanel Margin="0,0,0,16">
                    <Button x:Name="BtnDeleteMacro" DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="&#xE74D;" Margin="8,0,0,0"
                            ToolTip="Borrar macro" AutomationProperties.Name="Borrar macro" Click="BtnDeleteMacro_Click"/>
                    <Button x:Name="BtnTestMacro" DockPanel.Dock="Right" Style="{StaticResource Button.Small}" Click="BtnTestMacro_Click"
                            ToolTip="Envía la macro al mando virtual (la emulación debe estar activa)">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Text.IconInline}" Text="&#xE768;"/><TextBlock Text="Probar"/></StackPanel>
                    </Button>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Heading}" VerticalAlignment="Center"/>
                </DockPanel>

                <Grid Margin="{StaticResource Gap.Bottom3}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" MaxLength="64" AutomationProperties.Name="Nombre de la macro"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Se activa con" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{x:Static vm:EditorOptions.Buttons}" SelectedValuePath="Value"
                                  SelectedValue="{Binding TriggerButton}" AutomationProperties.Name="Botón que activa la macro"/>
                    </StackPanel>
                </Grid>
                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding RepeatWhileHeld}" Margin="0,0,0,16">
                    <TextBlock Style="{StaticResource Text.Base}" Text="Repetir mientras se mantiene el botón"/>
                </CheckBox>

                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Data}" VerticalAlignment="Center"
                               Text="{Binding TotalDurationMs, StringFormat=Duración total: {0} ms}"/>
                    <TextBlock Text="Pasos" Style="{StaticResource Text.Label}" VerticalAlignment="Center"/>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Steps}" Focusable="False" AutomationProperties.Name="Pasos de la macro"
                              VirtualizingPanel.IsVirtualizing="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card.Inset}" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" ItemsSource="{x:Static vm:EditorOptions.MacroStepTypes}" SelectedValuePath="Value"
                                              SelectedValue="{Binding StepType}" AutomationProperties.Name="Tipo de paso"/>
                                    <ComboBox Grid.Column="2" ItemsSource="{x:Static vm:EditorOptions.RealButtons}" SelectedValuePath="Value"
                                              SelectedValue="{Binding Button}" AutomationProperties.Name="Botón del paso"
                                              Visibility="{Binding UsesButton, Converter={StaticResource BoolToVis}}"/>
                                    <ComboBox Grid.Column="2" ItemsSource="{x:Static vm:VirtualKeyCatalog.Keys}" SelectedValuePath="Value"
                                              SelectedValue="{Binding VirtualKeyCode}" AutomationProperties.Name="Tecla del paso"
                                              Visibility="{Binding UsesKey, Converter={StaticResource BoolToVis}}"/>
                                    <TextBox Grid.Column="4" Text="{Binding DurationMs, UpdateSourceTrigger=LostFocus}"
                                             ToolTip="Duración del paso en milisegundos" AutomationProperties.Name="Duración en milisegundos"/>
                                    <TextBlock Grid.Column="5" Style="{StaticResource Text.Data}" Text="ms" Margin="6,0,8,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="6" Orientation="Horizontal">
                                        <Button Style="{StaticResource Button.IconSmall}" Content="&#xE70E;" ToolTip="Subir paso" AutomationProperties.Name="Subir paso"
                                                Command="{Binding DataContext.MoveStepUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Style="{StaticResource Button.IconSmall}" Content="&#xE70D;" ToolTip="Bajar paso" AutomationProperties.Name="Bajar paso"
                                                Command="{Binding DataContext.MoveStepDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Style="{StaticResource Button.IconSmall}" Content="&#xE711;" ToolTip="Quitar paso" AutomationProperties.Name="Quitar paso"
                                                Command="{Binding DataContext.RemoveStepCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <WrapPanel Margin="0,4,0,0">
                    <Button Style="{StaticResource Button.Small}" Command="{Binding AddStepCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Text.IconInline}" Text="&#xE710;"/><TextBlock Text="Agregar pulsación"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Small}" Command="{Binding AddWaitStepCommand}">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Text.IconInline}" Text="&#xE916;"/><TextBlock Text="Agregar espera"/></StackPanel>
                    </Button>
                </WrapPanel>
                <Border Background="{StaticResource Brush.InfoSoft}" CornerRadius="{StaticResource Radius.Md}" Padding="12,8" Margin="0,16,0,0">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE946;" Foreground="{StaticResource Brush.Info}" Margin="0,0,8,0" VerticalAlignment="Top"/>
                        <TextBlock Style="{StaticResource Text.Body}" FontSize="{StaticResource FontSize.Secondary}"
                                   Text="Las macros se ejecutan dentro del bucle de 1000 Hz, con precisión de 1 ms."/>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
