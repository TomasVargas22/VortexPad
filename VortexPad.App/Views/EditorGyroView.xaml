<UserControl x:Class="VortexPad.App.Views.EditorGyroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VortexPad.ViewModels;assembly=VortexPad.ViewModels"
             xmlns:views="clr-namespace:VortexPad.App.Views">
    <!-- Sección «Giroscopio». DataContext = ProfileEditorViewModel. -->
    <UserControl.Resources>
        <ResourceDictionary Source="EditorTemplates.xaml"/>
    </UserControl.Resources>

    <Grid DataContext="{Binding Gyro}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Salida y activación" Style="{StaticResource CardTitle}"/>
                <StackPanel Style="{StaticResource FieldBlock}">
                    <TextBlock Text="El giroscopio mueve" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{x:Static vm:EditorOptions.GyroOutputModes}" SelectedValuePath="Value"
                              SelectedValue="{Binding OutputMode}" AutomationProperties.Name="Salida del giroscopio"/>
                </StackPanel>
                <StackPanel IsEnabled="{Binding IsEnabled}">
                    <StackPanel Style="{StaticResource FieldBlock}">
                        <TextBlock Text="Activación" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{x:Static vm:EditorOptions.GyroActivationModes}" SelectedValuePath="Value"
                                  SelectedValue="{Binding ActivationMode}" AutomationProperties.Name="Activación del giroscopio"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource FieldBlock}" Visibility="{Binding NeedsActivationButton, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Botón de activación" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{x:Static vm:EditorOptions.RealButtons}" SelectedValuePath="Value"
                                  SelectedValue="{Binding ActivationButton}" AutomationProperties.Name="Botón de activación del giroscopio"/>
                    </StackPanel>
                    <WrapPanel>
                        <CheckBox Content="Invertir horizontal" IsChecked="{Binding InvertYaw}" Margin="0,0,24,0"/>
                        <CheckBox Content="Invertir vertical" IsChecked="{Binding InvertPitch}"/>
                    </WrapPanel>
                </StackPanel>
                <TextBlock Style="{StaticResource Text.SecondaryWrap}" Margin="0,12,0,0"
                           Text="Necesita un mando con giroscopio leído por HID nativo (DualSense o DualShock 4)."/>
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top" IsEnabled="{Binding IsEnabled}">
            <StackPanel>
                <TextBlock Text="Sensibilidad y filtro" Style="{StaticResource CardTitle}"/>
                <views:LabeledSlider Label="Sensibilidad horizontal" Format="{}{0:F1}×" Minimum="0.1" Maximum="10" Step="0.1"
                                     Value="{Binding SensitivityX}"/>
                <views:LabeledSlider Label="Sensibilidad vertical" Format="{}{0:F1}×" Minimum="0.1" Maximum="10" Step="0.1"
                                     Value="{Binding SensitivityY}"/>
                <views:LabeledSlider Label="Umbral de ruido" Format="{}{0:F2} °/s" Minimum="0" Maximum="5" Step="0.05"
                                     Value="{Binding NoiseThresholdDegPerSec}"/>
                <views:LabeledSlider Label="Suavizado" Format="percent" Minimum="0" Maximum="0.95" Step="0.01"
                                     Value="{Binding SmoothingFactor}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
