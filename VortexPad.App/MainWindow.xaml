<Window x:Class="VortexPad.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VortexPad.App.Views"
        Title="VortexPad — 1000Hz Next-Gen Controller Remapper (Xbox / PS5 / AI)"
        Width="1360" Height="840"
        MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimary}"
        Foreground="{StaticResource TextPrimary}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP HEADER BAR -->
        <Border Grid.Row="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="8" Background="#00E5FF" Margin="0,0,12,0">
                        <TextBlock Text="VP" Foreground="#061018" FontWeight="ExtraBold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="VORTEXPAD" FontSize="20" FontWeight="ExtraBold" Foreground="#F8FAFC"/>
                            <Border Background="#1E293B" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="1000Hz ENGINE" FontSize="10" FontWeight="Bold" Foreground="#00E5FF"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="DirectInput &amp; HID → Xbox 360 / DualShock 4 / PS5 / AI Auto-Calibration" FontSize="11.5" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Quick Built-in Preset Pills -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Perfiles Rápidos:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0" FontSize="12"/>
                    <Button x:Name="BtnPresetXbox" Style="{StaticResource FluentButton}" Click="BtnPresetXbox_Click" Margin="0,0,6,0" Content="🎮 Xbox (Standard / Series)"/>
                    <Button x:Name="BtnPresetPs5" Style="{StaticResource FluentButton}" Click="BtnPresetPs5_Click" Margin="0,0,6,0" Content="🔵 PS5 / PlayStation (DualSense)"/>
                    <Button x:Name="BtnPresetAi" Style="{StaticResource FluentButton}" Click="BtnPresetAi_Click" Content="✨ AI Smart Profile (Auto)"/>
                </StackPanel>

                <!-- Engine Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkDemoSignal" Content="Simulador en Vivo" Foreground="#00E5FF" VerticalAlignment="Center" Margin="0,0,14,0" Checked="ChkDemoSignal_Changed" Unchecked="ChkDemoSignal_Changed"/>
                    <Button x:Name="BtnToggleEngine" Style="{StaticResource PrimaryCyanButton}" Click="BtnToggleEngine_Click" Padding="16,8" Content="▶ Iniciar Emulación 1000Hz"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TELEMETRY & DRIVER STATUS STRIP -->
        <Border Grid.Row="1" Background="#0F141E" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="1.3*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Polling Real:" Foreground="{StaticResource TextSecondary}" Margin="0,0,6,0"/>
                    <TextBlock x:Name="TxtPollingHz" Text="1000.0 Hz" Foreground="#10B981" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Latencia / Jitter:" Foreground="{StaticResource TextSecondary}" Margin="0,0,6,0"/>
                    <TextBlock x:Name="TxtLatencyJitter" Text="4.2 µs / 0.015 ms" Foreground="#00E5FF" FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="Proceso Activo:" Foreground="{StaticResource TextSecondary}" Margin="0,0,6,0"/>
                    <TextBlock x:Name="TxtActiveProcess" Text="Ninguno (Auto-Switch listo)" Foreground="#E2E8F0" FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <TextBlock Text="ViGEmBus:" Foreground="{StaticResource TextSecondary}" Margin="0,0,6,0"/>
                    <TextBlock x:Name="TxtVigemStatus" Text="Listo" Foreground="#10B981" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <TextBlock Text="HidHide:" Foreground="{StaticResource TextSecondary}" Margin="0,0,6,0"/>
                    <TextBlock x:Name="TxtHidHideStatus" Text="Listo" Foreground="#A78BFA" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN 3-COLUMN WORKSPACE -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="370"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: DEVICES, PROFILES & AI CALIBRATION -->
            <Border Grid.Column="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="1. MANDO FÍSICO DE ENTRADA" FontSize="12" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CmbPhysicalDevices" Grid.Column="0" SelectionChanged="CmbPhysicalDevices_SelectionChanged" Height="30" Margin="0,0,6,0"/>
                            <Button Grid.Column="1" Style="{StaticResource FluentButton}" Click="BtnRefreshDevices_Click" Content="↻"/>
                        </Grid>
                        <TextBlock x:Name="TxtAiDeviceSignature" Text="AI Detector: Selecciona un dispositivo" FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                        <Separator Background="{StaticResource BorderSubtle}" Margin="0,0,0,12"/>

                        <TextBlock Text="2. GESTOR DE PERFILES" FontSize="12" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,6"/>
                        <ListBox x:Name="LstProfiles" Height="130" Background="#0F141E" Foreground="#F1F5F9" BorderBrush="{StaticResource BorderSubtle}" SelectionChanged="LstProfiles_SelectionChanged" DisplayMemberPath="Name" Margin="0,0,0,8"/>

                        <UniformGrid Columns="2" Margin="0,0,0,6">
                            <Button Style="{StaticResource FluentButton}" Click="BtnCloneProfile_Click" Margin="0,0,4,0" Content="+ Clonar Perfil"/>
                            <Button Style="{StaticResource FluentButton}" Click="BtnSaveProfile_Click" Margin="4,0,0,0" Content="💾 Guardar"/>
                        </UniformGrid>
                        <UniformGrid Columns="3" Margin="0,0,0,6">
                            <Button Style="{StaticResource FluentButton}" Click="BtnImportProfile_Click" Margin="0,0,3,0" Padding="6,5" Content="📂 Importar"/>
                            <Button Style="{StaticResource FluentButton}" Click="BtnExportProfile_Click" Margin="3,0,3,0" Padding="6,5" Content="📤 Exportar"/>
                            <Button x:Name="BtnDeleteProfile" Style="{StaticResource FluentButton}" Click="BtnDeleteProfile_Click" Margin="3,0,0,0" Padding="6,5" Content="🗑 Eliminar"/>
                        </UniformGrid>
                        <TextBlock Text="Nombre, mando virtual, color, HidHide y auto-switch se editan en la pestaña General del editor."
                                   FontSize="10.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <Separator Background="{StaticResource BorderSubtle}" Margin="0,0,0,12"/>

                        <!-- AI MODULE -->
                        <Border Background="#18122B" BorderBrush="#9D4EDD" BorderThickness="1" CornerRadius="8" Padding="10">
                            <StackPanel>
                                <TextBlock Text="✨ VORTEXPAD AI ASSISTANT" FontSize="12" FontWeight="Bold" Foreground="#C77DFF" Margin="0,0,0,6"/>
                                <Button x:Name="BtnAiCalibrateDrift" Style="{StaticResource FluentButton}" Click="BtnAiCalibrateDrift_Click" Margin="0,0,0,4" Content="🎯 Auto-Calibrar Drift y Deadzone"/>
                                <ProgressBar x:Name="BarCalibration" Minimum="0" Maximum="1" Height="6" Foreground="#C77DFF" Background="#1E293B" Margin="0,0,0,8" Visibility="Collapsed"/>
                                <TextBlock Text="Optimización AI por Género:" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CmbAiGenre" Grid.Column="0" SelectedIndex="0" Height="28" Margin="0,0,6,0">
                                        <ComboBoxItem Content="Competitive FPS (S-Curve + Gyro)"/>
                                        <ComboBoxItem Content="Racing / Sim (Pedales Progresivos)"/>
                                        <ComboBoxItem Content="Fighting / Arcade (Snap Axial)"/>
                                        <ComboBoxItem Content="Soulslike / Action RPG"/>
                                        <ComboBoxItem Content="General Action (Balanceado)"/>
                                    </ComboBox>
                                    <Button Grid.Column="1" Style="{StaticResource FluentButton}" Click="BtnApplyAiGenre_Click" Content="Aplicar"/>
                                </Grid>
                                <TextBlock x:Name="TxtAiCalibrationResult" Text="Listo para analizar ruido del sensor y sugerir curvas óptimas." FontSize="11" Foreground="#E0AAFF" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Separator Background="{StaticResource BorderSubtle}" Margin="0,12,0,12"/>

                        <!-- APP SETTINGS (settings.json, AppSettingsViewModel) -->
                        <StackPanel x:Name="SettingsPanel">
                            <TextBlock Text="3. AJUSTES DE LA APP" FontSize="12" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,6"/>
                            <CheckBox Content="Cambiar de perfil según el juego activo" IsChecked="{Binding AutoSwitchEnabled}" Foreground="#E2E8F0" Margin="0,0,0,5"/>
                            <CheckBox Content="Iniciar emulación al abrir VortexPad" IsChecked="{Binding StartEmulationOnLaunch}" Foreground="#E2E8F0" Margin="0,0,0,5"/>
                            <CheckBox Content="Minimizar a la bandeja del sistema" IsChecked="{Binding MinimizeToTray}" Foreground="#E2E8F0" Margin="0,0,0,5"/>
                            <CheckBox Content="Iniciar con Windows (minimizado)" IsChecked="{Binding StartWithWindows}" Foreground="#E2E8F0" Margin="0,0,0,8"/>
                            <Button Style="{StaticResource FluentButton}" Click="BtnOpenLogs_Click" HorizontalAlignment="Left" Padding="8,4" FontSize="11" Content="📄 Abrir carpeta de logs"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- CENTER COLUMN: LIVE INTERACTIVE CONTROLLER VISUALIZER -->
            <Border Grid.Column="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title & Active Preset Description -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <Grid>
                            <TextBlock x:Name="TxtActiveProfileTitle" Text="Perfil Activo: Xbox (Standard / Series)" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                            <Border x:Name="BdLightbarPreview" HorizontalAlignment="Right" Width="95" Height="22" CornerRadius="11" Background="#00E5FF" BorderBrush="#FFFFFF" BorderThickness="1">
                                <TextBlock Text="LED LIGHTBAR" FontSize="9" FontWeight="Bold" Foreground="#04080E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="TxtActiveProfileDesc" Text="Descripción del perfil..." FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Triggers L2 / R2 Live Bars -->
                    <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,14">
                        <Border Background="#0F141E" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,6,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="GATILLO IZQUIERDO (LT / L2)" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="TxtL2Value" Text="0%" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <ProgressBar x:Name="BarL2" Minimum="0" Maximum="1" Height="12" Foreground="#00E5FF" Background="#1E293B"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0F141E" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="6,0,0,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="GATILLO DERECHO (RT / R2)" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="TxtR2Value" Text="0%" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <ProgressBar x:Name="BarR2" Minimum="0" Maximum="1" Height="12" Foreground="#00E5FF" Background="#1E293B"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Dual Stick 2D Radar Visualizer + Buttons -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <UniformGrid Grid.Row="0" Columns="2" Margin="0,0,0,12">
                            <!-- Left Stick Radar -->
                            <Border Background="#0B0F17" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,6,0">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="STICK IZQUIERDO (Raw vs Procesado)" FontSize="11.5" FontWeight="Bold" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <Canvas x:Name="CanvasLeftStick" Width="170" Height="170" Background="#111827" ClipToBounds="True">
                                        <Ellipse Width="168" Height="168" Canvas.Left="1" Canvas.Top="1" Stroke="#334155" StrokeThickness="1.5"/>
                                        <Line X1="85" Y1="0" X2="85" Y2="170" Stroke="#1E293B" StrokeThickness="1"/>
                                        <Line X1="0" Y1="85" X2="170" Y2="85" Stroke="#1E293B" StrokeThickness="1"/>
                                        <!-- Deadzone Circle -->
                                        <Ellipse x:Name="EllipseLeftDeadzone" Width="28" Height="28" Canvas.Left="71" Canvas.Top="71" Stroke="#EF4444" StrokeThickness="1.5" StrokeDashArray="3,2" Fill="#22EF4444"/>
                                        <!-- Raw Dot -->
                                        <Ellipse x:Name="DotLeftRaw" Width="8" Height="8" Canvas.Left="81" Canvas.Top="81" Fill="#64748B"/>
                                        <!-- Processed Output Dot -->
                                        <Ellipse x:Name="DotLeftOut" Width="12" Height="12" Canvas.Left="79" Canvas.Top="79" Fill="#00E5FF" Stroke="#FFFFFF" StrokeThickness="1.5"/>
                                    </Canvas>
                                    <TextBlock x:Name="TxtLeftStickCoords" Text="Raw: (0.00, 0.00) → Out: (0.00, 0.00)" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Right Stick Radar -->
                            <Border Background="#0B0F17" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="6,0,0,0">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="STICK DERECHO + GIROSCOPIO" FontSize="11.5" FontWeight="Bold" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <Canvas x:Name="CanvasRightStick" Width="170" Height="170" Background="#111827" ClipToBounds="True">
                                        <Ellipse Width="168" Height="168" Canvas.Left="1" Canvas.Top="1" Stroke="#334155" StrokeThickness="1.5"/>
                                        <Line X1="85" Y1="0" X2="85" Y2="170" Stroke="#1E293B" StrokeThickness="1"/>
                                        <Line X1="0" Y1="85" X2="170" Y2="85" Stroke="#1E293B" StrokeThickness="1"/>
                                        <!-- Deadzone Circle -->
                                        <Ellipse x:Name="EllipseRightDeadzone" Width="28" Height="28" Canvas.Left="71" Canvas.Top="71" Stroke="#EF4444" StrokeThickness="1.5" StrokeDashArray="3,2" Fill="#22EF4444"/>
                                        <!-- Raw Dot -->
                                        <Ellipse x:Name="DotRightRaw" Width="8" Height="8" Canvas.Left="81" Canvas.Top="81" Fill="#64748B"/>
                                        <!-- Processed Output Dot -->
                                        <Ellipse x:Name="DotRightOut" Width="12" Height="12" Canvas.Left="79" Canvas.Top="79" Fill="#9D4EDD" Stroke="#FFFFFF" StrokeThickness="1.5"/>
                                    </Canvas>
                                    <TextBlock x:Name="TxtRightStickCoords" Text="Raw: (0.00, 0.00) → Out: (0.00, 0.00)" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Live Button Matrix -->
                        <Border Grid.Row="1" Background="#0F141E" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="10">
                            <StackPanel>
                                <TextBlock Text="ESTADO DE BOTONES VIRTUALES EN TIEMPO REAL (Incluye Turbo / Macros / Shift)" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                                <UniformGrid Columns="6">
                                    <Border x:Name="PillBtnSouth" Background="#1E293B" CornerRadius="5" Padding="6,5" Margin="2"><TextBlock x:Name="LblBtnSouth" Text="A / ✕" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold"/></Border>
                                    <Border x:Name="PillBtnEast" Background="#1E293B" CornerRadius="5" Padding="6,5" Margin="2"><TextBlock x:Name="LblBtnEast" Text="B / ○" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold"/></Border>
                                    <Border x:Name="PillBtnWest" Background="#1E293B" CornerRadius="5" Padding="6,5" Margin="2"><TextBlock x:Name="LblBtnWest" Text="X / □" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold"/></Border>
                                    <Border x:Name="PillBtnNorth" Background="#1E293B" CornerRadius="5" Padding="6,5" Margin="2"><TextBlock x:Name="LblBtnNorth" Text="Y / △" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold"/></Border>
                                    <Border x:Name="PillBtnLB" Background="#1E293B" CornerRadius="5" Padding="6,5" Margin="2"><TextBlock Text="LB / L1" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold"/></Border>
                                    <Border x:Name="PillBtnRB" Background="#1E293B" CornerRadius="5" Padding="6,5" Margin="2"><TextBlock Text="RB / R1" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold"/></Border>
                                    <Border x:Name="PillBtnBack" Background="#1E293B" CornerRadius="5" Padding="6,5" Margin="2"><TextBlock Text="View / Share" HorizontalAlignment="Center" FontSize="11"/></Border>
                                    <Border x:Name="PillBtnStart" Background="#1E293B" CornerRadius="5" Padding="6,5" Margin="2"><TextBlock Text="Menu / Opt" HorizontalAlignment="Center" FontSize="11"/></Border>
                                    <Border x:Name="PillBtnGuide" Background="#1E293B" CornerRadius="5" Padding="6,5" Margin="2"><TextBlock Text="Xbox / PS" HorizontalAlignment="Center" FontSize="11"/></Border>
                                    <Border x:Name="PillBtnTouchpad" Background="#1E293B" CornerRadius="5" Padding="6,5" Margin="2"><TextBlock Text="Touchpad" HorizontalAlignment="Center" FontSize="11"/></Border>
                                    <Border x:Name="PillBtnL3" Background="#1E293B" CornerRadius="5" Padding="6,5" Margin="2"><TextBlock Text="L3" HorizontalAlignment="Center" FontSize="11"/></Border>
                                    <Border x:Name="PillBtnR3" Background="#1E293B" CornerRadius="5" Padding="6,5" Margin="2"><TextBlock Text="R3" HorizontalAlignment="Center" FontSize="11"/></Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Force Feedback & Gyro Live Meters -->
                    <UniformGrid Grid.Row="3" Columns="3" Margin="0,12,0,0">
                        <Border Background="#0F141E" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,4,0">
                            <StackPanel>
                                <TextBlock Text="Vibración Motor Pesado" FontSize="10.5" Foreground="{StaticResource TextSecondary}"/>
                                <ProgressBar x:Name="BarRumbleLarge" Minimum="0" Maximum="1" Height="8" Foreground="#F59E0B" Background="#1E293B" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#0F141E" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="2,0,2,0">
                            <StackPanel>
                                <TextBlock Text="Vibración Motor Fino" FontSize="10.5" Foreground="{StaticResource TextSecondary}"/>
                                <ProgressBar x:Name="BarRumbleSmall" Minimum="0" Maximum="1" Height="8" Foreground="#10B981" Background="#1E293B" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#0F141E" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="4,0,0,0">
                            <StackPanel>
                                <TextBlock x:Name="TxtGyroTelemetry" Text="Gyro IMU: 0.0°/s | Mouse Δ: (0, 0)" FontSize="10.5" Foreground="#00E5FF"/>
                                <UniformGrid Columns="2" Margin="0,3,0,0">
                                    <Button Style="{StaticResource FluentButton}" Click="BtnTestRumble_Click" Padding="4,2" Margin="0,0,2,0" FontSize="10" Content="Probar Vibración"/>
                                    <Button Style="{StaticResource FluentButton}" Click="BtnTriggerComboMacro_Click" Padding="4,2" Margin="2,0,0,0" FontSize="10" Content="⚡ Macro A→B→X→Y"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- RIGHT COLUMN: FULL PROFILE EDITOR (MVVM, see VortexPad.ViewModels) -->
            <Border Grid.Column="2" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="12">
                <views:ProfileEditorView x:Name="ProfileEditor"/>
            </Border>
        </Grid>

        <!-- FOOTER BAR -->
        <Border Grid.Row="3" Margin="0,10,0,0">
            <DockPanel>
                <TextBlock x:Name="TxtFooterStatus" Text="VortexPad listo. Motor de 1000Hz activo." FontSize="11.5" Foreground="{StaticResource TextSecondary}"/>
                <TextBlock Text="Bandeja del sistema (System Tray) activa • ViGEmBus + HidHide Ready" FontSize="11.5" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
