<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <ApplicationTitle>VortexPad</ApplicationTitle>

    <!-- Identity: the version is overridden in the release workflow with the tag (/p:Version=x.y.z) -->
    <Version>0.1.0</Version>
    <Product>VortexPad</Product>
    <Company>VortexPad</Company>
    <Description>Remapeador de mandos a 1000 Hz (Xbox / DualShock 4 / teclado y ratón)</Description>
    <Copyright>© VortexPad</Copyright>
    <ApplicationIcon>Assets\vortexpad.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!--
    Distribution publish: dotnet publish VortexPad.App -c Release -r win-x64
    Self-contained (no .NET install needed) and single-file. Native libraries (WPF included) are
    extracted on first launch to the user's temporary folder.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <!-- Do not copy the .pdb files of the other projects next to the exe -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\vortexpad.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VortexPad.Core\VortexPad.Core.csproj" />
    <ProjectReference Include="..\VortexPad.Input\VortexPad.Input.csproj" />
    <ProjectReference Include="..\VortexPad.Emulation\VortexPad.Emulation.csproj" />
    <ProjectReference Include="..\VortexPad.AI\VortexPad.AI.csproj" />
    <ProjectReference Include="..\VortexPad.ViewModels\VortexPad.ViewModels.csproj" />
  </ItemGroup>

</Project>
