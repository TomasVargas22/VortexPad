<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
        Tokens del sistema de diseño VortexPad (R2). Mismas claves que tokens.json del sistema en Claude Design.
        Único sitio con colores literales de la app: el resto usa estos recursos.
    -->

    <!-- ===== Colores ===== -->
    <Color x:Key="Color.Bg">#0B0E14</Color>
    <Color x:Key="Color.Surface">#131822</Color>
    <Color x:Key="Color.Surface2">#1B2230</Color>
    <Color x:Key="Color.Surface3">#252E3E</Color>
    <Color x:Key="Color.Line">#12FFFFFF</Color>
    <Color x:Key="Color.LineStrong">#3D4A60</Color>
    <Color x:Key="Color.LineControl">#5F6D85</Color>
    <Color x:Key="Color.Text">#F1F5F9</Color>
    <Color x:Key="Color.TextMuted">#A3B0C2</Color>
    <Color x:Key="Color.TextFaint">#7E8BA0</Color>
    <Color x:Key="Color.Accent">#00E5FF</Color>
    <Color x:Key="Color.AccentHover">#5CF0FF</Color>
    <Color x:Key="Color.AccentPressed">#00C2D9</Color>
    <Color x:Key="Color.AccentInk">#061018</Color>
    <Color x:Key="Color.AccentSoft">#1F00E5FF</Color>
    <Color x:Key="Color.LiveIn">#8794AA</Color>
    <Color x:Key="Color.LiveAlt">#C4A5FF</Color>
    <Color x:Key="Color.Ok">#34D399</Color>
    <Color x:Key="Color.OkSoft">#1F34D399</Color>
    <Color x:Key="Color.Warn">#F5B544</Color>
    <Color x:Key="Color.WarnInk">#1A1205</Color>
    <Color x:Key="Color.WarnSoft">#1FF5B544</Color>
    <Color x:Key="Color.Danger">#FF7085</Color>
    <Color x:Key="Color.DangerSoft">#1FFF7085</Color>
    <Color x:Key="Color.DangerFill">#2EFF7085</Color>
    <Color x:Key="Color.Info">#82ADFF</Color>
    <Color x:Key="Color.InfoSoft">#1F82ADFF</Color>
    <Color x:Key="Color.Transparent">#00000000</Color>

    <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource Color.Bg}"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}"/>
    <SolidColorBrush x:Key="Brush.Surface2" Color="{StaticResource Color.Surface2}"/>
    <SolidColorBrush x:Key="Brush.Surface3" Color="{StaticResource Color.Surface3}"/>
    <SolidColorBrush x:Key="Brush.Line" Color="{StaticResource Color.Line}"/>
    <SolidColorBrush x:Key="Brush.LineStrong" Color="{StaticResource Color.LineStrong}"/>
    <SolidColorBrush x:Key="Brush.LineControl" Color="{StaticResource Color.LineControl}"/>
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}"/>
    <SolidColorBrush x:Key="Brush.TextFaint" Color="{StaticResource Color.TextFaint}"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}"/>
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="{StaticResource Color.AccentPressed}"/>
    <SolidColorBrush x:Key="Brush.AccentInk" Color="{StaticResource Color.AccentInk}"/>
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.AccentSoft}"/>
    <SolidColorBrush x:Key="Brush.LiveIn" Color="{StaticResource Color.LiveIn}"/>
    <SolidColorBrush x:Key="Brush.LiveAlt" Color="{StaticResource Color.LiveAlt}"/>
    <SolidColorBrush x:Key="Brush.Ok" Color="{StaticResource Color.Ok}"/>
    <SolidColorBrush x:Key="Brush.OkSoft" Color="{StaticResource Color.OkSoft}"/>
    <SolidColorBrush x:Key="Brush.Warn" Color="{StaticResource Color.Warn}"/>
    <SolidColorBrush x:Key="Brush.WarnInk" Color="{StaticResource Color.WarnInk}"/>
    <SolidColorBrush x:Key="Brush.WarnSoft" Color="{StaticResource Color.WarnSoft}"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}"/>
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="{StaticResource Color.DangerSoft}"/>
    <SolidColorBrush x:Key="Brush.DangerFill" Color="{StaticResource Color.DangerFill}"/>
    <SolidColorBrush x:Key="Brush.Info" Color="{StaticResource Color.Info}"/>
    <SolidColorBrush x:Key="Brush.InfoSoft" Color="{StaticResource Color.InfoSoft}"/>
    <SolidColorBrush x:Key="Brush.Transparent" Color="{StaticResource Color.Transparent}"/>

    <!-- ===== Tipografía ===== -->
    <FontFamily x:Key="Font.Sans">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="FontSize.PageTitle">22</sys:Double>
    <sys:Double x:Key="FontSize.Hero">18</sys:Double>
    <sys:Double x:Key="FontSize.Heading">15</sys:Double>
    <sys:Double x:Key="FontSize.Body">14</sys:Double>
    <sys:Double x:Key="FontSize.Secondary">13</sys:Double>
    <sys:Double x:Key="FontSize.Caption">12</sys:Double>
    <sys:Double x:Key="FontSize.Label">11</sys:Double>
    <sys:Double x:Key="FontSize.DataLg">20</sys:Double>
    <sys:Double x:Key="FontSize.Data">12</sys:Double>
    <sys:Double x:Key="FontSize.Icon">16</sys:Double>

    <!-- ===== Espaciado (4/8/12/16/24/32/48) ===== -->
    <sys:Double x:Key="Space.1">4</sys:Double>
    <sys:Double x:Key="Space.2">8</sys:Double>
    <sys:Double x:Key="Space.3">12</sys:Double>
    <sys:Double x:Key="Space.4">16</sys:Double>
    <sys:Double x:Key="Space.5">24</sys:Double>
    <sys:Double x:Key="Space.6">32</sys:Double>
    <sys:Double x:Key="Space.7">48</sys:Double>

    <Thickness x:Key="Pad.Card">16</Thickness>
    <Thickness x:Key="Pad.Page">24</Thickness>
    <Thickness x:Key="Pad.PageCompact">16</Thickness>
    <Thickness x:Key="Gap.Bottom2">0,0,0,8</Thickness>
    <Thickness x:Key="Gap.Bottom3">0,0,0,12</Thickness>
    <Thickness x:Key="Gap.Bottom4">0,0,0,16</Thickness>
    <Thickness x:Key="Gap.Right2">0,0,8,0</Thickness>
    <Thickness x:Key="Gap.Right3">0,0,12,0</Thickness>
    <Thickness x:Key="Gap.Right4">0,0,16,0</Thickness>

    <!-- ===== Radios ===== -->
    <CornerRadius x:Key="Radius.Sm">6</CornerRadius>
    <CornerRadius x:Key="Radius.Md">8</CornerRadius>
    <CornerRadius x:Key="Radius.Lg">12</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

    <!-- ===== Tamaños ===== -->
    <sys:Double x:Key="Size.TargetMin">32</sys:Double>
    <sys:Double x:Key="Size.ControlSm">28</sys:Double>
    <sys:Double x:Key="Size.ControlMd">36</sys:Double>
    <sys:Double x:Key="Size.ControlLg">44</sys:Double>
    <sys:Double x:Key="Size.NavW">232</sys:Double>
    <sys:Double x:Key="Size.NavCollapsedW">64</sys:Double>
    <sys:Double x:Key="Size.TopbarH">56</sys:Double>
    <sys:Double x:Key="Size.Radar">168</sys:Double>

    <!-- ===== Movimiento ===== -->
    <Duration x:Key="Duration.Fast">0:0:0.12</Duration>
    <Duration x:Key="Duration.Base">0:0:0.18</Duration>
    <Duration x:Key="Duration.Slow">0:0:0.28</Duration>
</ResourceDictionary>
